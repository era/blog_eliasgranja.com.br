<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ content.title }} — {{ website_name }}</title>
  <meta name="description" content="{{ content.description }}">
  <meta name="author" content="{{ author }}">
  <link rel="canonical" href="{{ content.url }}">
  <link rel="alternate" type="application/rss+xml" title="{{ website_name }}" href="{{ uri }}/rss.xml">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/style.css">
  <meta name="theme-color" content="#fcfbf7" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="#121310" media="(prefers-color-scheme: dark)">
  <meta property="og:type" content="article">
  <meta property="og:site_name" content="{{ website_name }}">
  <meta property="og:title" content="{{ content.title }}">
  <meta property="og:description" content="{{ content.description }}">
  <meta property="og:url" content="{{ content.url }}">
  <meta property="og:locale" content="pt_BR">
  <meta property="article:published_time" content="{{ content.date }}">
  <meta property="article:author" content="{{ author }}">
</head>
<body>
  <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
  {{ render('templates/_nav.template') }}
  <main id="conteudo">
    <div class="wrap">
      <article class="article">
        <header class="article-head">
          <h1>{{ content.title }}</h1>
          <p class="article-meta">
            <time datetime="{{ content.date }}">{{ date_format(content.date, '%d.%m.%Y') }}</time>
          </p>
        </header>
        <div class="prose">
          {{ content.content }}
        </div>
        {% if content.previous != Nil or content.next != Nil %}
        <nav class="post-nav" aria-label="Navegação entre artigos">
          {% if content.previous != Nil %}
          <a class="prev" href="{{ content.previous.partial_uri }}">
            <span class="label">Mais antigo</span>
            {{ content.previous.title }}
          </a>
          {% end %}
          {% if content.next != Nil %}
          <a class="next" href="{{ content.next.partial_uri }}">
            <span class="label">Mais recente</span>
            {{ content.next.title }}
          </a>
          {% end %}
        </nav>
        {% end %}
      </article>
    </div>
  </main>
  {{ render('templates/_footer.template') }}
